PORT=4000
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/stayhub?retryWrites=true&w=majority
JWT_SECRET=<cadena-larga-y-aleatoria>
CORS_ORIGIN=http://localhost:5173

# Cloudinary (fotos de hoteles y habitaciones). Se copian del panel de tu cuenta.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Opcionales: solo los usa `pnpm seed` para crear al administrador.
# Si no se definen, se usan las credenciales de demo del README.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
